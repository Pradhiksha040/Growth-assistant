# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application Environment
APP_NAME="The Lenny Growth Assistant"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"

# API & Server Configuration
PORT=8000
HOST="0.0.0.0"
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL / Supabase / Railway / Local fallback)
# If PostgreSQL is not reachable, the system automatically falls back to SQLite
# without interrupting runtime operations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lenny_growth"
SQLITE_FALLBACK_URL="sqlite:///./data/lenny_assistant.db"

# Active LLM Provider Selection:
# Options: 'ollama' (local) | 'anthropic' (cloud) | 'openai' (cloud) | 'offline' (zero-config local)
DEFAULT_PROVIDER="ollama"

# ------------------------------------------------------------------------------
# Local LLM Provider: Ollama (Mandatory for Take-Home Demo)
# ------------------------------------------------------------------------------
# 1. Install Ollama: https://ollama.com
# 2. Run service: 'ollama serve'
# 3. Pull model: 'ollama pull llama3.2'
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# Cloud LLM Provider: Anthropic Claude (Optional)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# ------------------------------------------------------------------------------
# Cloud LLM Provider: OpenAI (Optional)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# ------------------------------------------------------------------------------
# Knowledge Base & Retrieval Parameters
# ------------------------------------------------------------------------------
DATA_DIR="data"
TRANSCRIPTS_DIR="data/transcripts"
CHUNK_SIZE=650
CHUNK_OVERLAP=120
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.15

# ------------------------------------------------------------------------------
# Frontend URL / CORS
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","*"]
